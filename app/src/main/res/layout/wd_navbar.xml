<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/HorizontalList">

    <FrameLayout
        android:id="@+id/home_nav"
        android:layout_weight="1"
        android:layout_marginEnd="2dp"
        style="@style/BTN1">

        <ImageView
            android:src="@drawable/icon_bullet_list_solid"
            android:contentDescription="@string/altdescr_home_nav"
            style="@style/Icon24" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/stopwatch_nav"
        android:layout_weight="1"
        android:layout_marginEnd="2dp"
        style="@style/BTN1">

        <ImageView
            android:src="@drawable/icon_stopwatch"
            android:contentDescription="@string/altdescr_stopwatch_nav"
            style="@style/Icon24" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/timer_nav"
        android:layout_weight="1"
        android:layout_marginEnd="2dp"
        style="@style/BTN1">

        <ImageView
            android:src="@drawable/icon_timer_solid"
            android:contentDescription="@string/altdescr_timer_nav"
            style="@style/Icon24" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/roulette_nav"
        android:layout_weight="1"
        style="@style/BTN1">

        <ImageView
            android:src="@drawable/icon_timer_solid"
            android:contentDescription="@string/altdescr_timer_nav"
            style="@style/Icon24" />
    </FrameLayout>
</LinearLayout>
