<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:padding="16sp"
    android:background="@color/bg_1"
    android:focusableInTouchMode="true"
    style="@style/VerticalListDivided">

    <TextView
        android:id="@+id/modal_title"
        android:text="@string/h2_edit_task"
        style="@style/H2_center" />

    <!-- Kept for layout inflation compatibility, never shown -->
    <ListView
        android:id="@+id/existing_tasks_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout style="@style/VerticalListDivided_BG2">

        <TextView
            android:text="@string/label_task_label"
            style="@style/Text" />

        <AutoCompleteTextView
            android:id="@+id/label"
            android:completionThreshold="1"
            style="@style/EditText" />

        <TextView
            android:text="@string/label_task_duration"
            style="@style/Text" />

        <EditText
            android:id="@+id/duration"
            style="@style/EditText" />
    </LinearLayout>

    <Button
        android:id="@+id/delete_button"
        android:text="@string/btn_delete_task"
        style="@style/BTN_danger" />

    <Button
        android:id="@+id/add_button"
        android:text="@string/btn_update_task"
        style="@style/BTN2" />

    <Button
        android:id="@+id/cancel_button"
        android:text="@string/btn_cancel"
        style="@style/BTN1" />
</LinearLayout>