<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_height="match_parent"
    android:background="@color/bg_1"
    style="@style/VerticalListDivided">

    <LinearLayout
        android:id="@+id/time_container"
        android:paddingTop="32sp"
        android:paddingBottom="32sp"
        style="@style/VerticalList">

        <TextView
            android:id="@+id/current_task_name"
            android:textColor="@color/foreground"
            android:text="@string/h2_greeting"
            style="@style/H2_center" />

        <TextView
            android:id="@+id/current_task_timer"
            android:text="@string/h1_timer_zero"
            style="@style/H1_center" />

        <TextView
            android:id="@+id/next_task_name"
            android:textColor="@color/disabled"
            android:text="@string/h2_next_placeholder"
            style="@style/H2_center" />

        <LinearLayout
            android:id="@+id/controllers"
            android:visibility="gone"
            android:layout_marginTop="8sp"
            android:gravity="center"
            style="@style/HorizontalListDivided">

            <FrameLayout
                android:id="@+id/repeat_task"
                style="@style/BTN3">

                <ImageView
                    android:src="@drawable/icon_refresh"
                    android:contentDescription="@string/altdescr_repeat_task"
                    style="@style/Icon24" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/increase_duration"
                style="@style/BTN3">

                <ImageView
                    android:src="@drawable/icon_30_timer"
                    android:contentDescription="@string/altdescr_increase_duration"
                    style="@style/Icon24" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/start_task"
                style="@style/BTN3">

                <ImageView
                    android:id="@+id/play_pause_icon"
                    android:src="@drawable/icon_play"
                    android:contentDescription="@string/altdescr_play_pause"
                    style="@style/Icon24" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/next_task"
                style="@style/BTN3">

                <ImageView
                    android:src="@drawable/icon_next"
                    android:contentDescription="@string/altdescr_skip_task"
                    style="@style/Icon24" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/task_list"
        android:layout_height="0dp"
        android:layout_weight="1"
        style="@style/VerticalListDivided" />

    <Button
        android:id="@+id/add_group_button"
        android:visibility="gone"
        android:text="@string/btn_add_group"
        style="@style/BTN2" />

    <Button
        android:id="@+id/edit_button"
        android:text="@string/btn_switch_to_edit_mode"
        style="@style/BTN2" />

    <Button
        android:id="@+id/work_button"
        android:visibility="gone"
        android:text="@string/btn_switch_to_work_mode"
        style="@style/BTN2" />

</LinearLayout>
