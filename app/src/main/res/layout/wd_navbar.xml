<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/HorizontalListDividedSmall">

    <FrameLayout
        android:id="@+id/home_nav"
        android:layout_weight="1"
        style="@style/BTN1">

        <ImageView
            android:src="@drawable/px_bullet_list"
            android:contentDescription="@string/altdescr_home_nav"
            android:tint="@color/bg_1"
            style="@style/Icon24" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/stopwatch_nav"
        android:layout_weight="1"
        style="@style/BTN1">

        <ImageView
            android:src="@drawable/px_stopwatch"
            android:contentDescription="@string/altdescr_stopwatch_nav"
            android:tint="@color/bg_1"
            style="@style/Icon24" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/timer_nav"
        android:layout_weight="1"
        style="@style/BTN1">

        <ImageView
            android:src="@drawable/px_timer"
            android:contentDescription="@string/altdescr_timer_nav"
            android:tint="@color/bg_1"
            style="@style/Icon24" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/roulette_nav"
        android:layout_weight="1"
        style="@style/BTN1">

        <ImageView
            android:src="@drawable/px_shuffle"
            android:contentDescription="@string/altdescr_shuffle_nav"
            android:tint="@color/bg_1"
            style="@style/Icon24" />
    </FrameLayout>
</LinearLayout>
