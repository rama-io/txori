<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_row_header"
    style="@style/HorizontalListDivided">

    <FrameLayout
        android:id="@+id/edit_session_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12sp"
        android:paddingStart="22sp"
        android:contentDescription="@string/cd_edit_session">

        <ImageView
            android:src="@drawable/icon_edit"
            android:contentDescription="@string/cd_edit_session"
            style="@style/Icon18" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ascend_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12sp"
        android:contentDescription="@string/cd_ascend">

        <ImageView
            android:src="@drawable/icon_chevron_up_solid"
            android:contentDescription="@string/cd_ascend"
            style="@style/Icon18" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/descend_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12sp"
        android:contentDescription="@string/cd_descend">

        <ImageView
            android:src="@drawable/icon_chevron_down_solid"
            android:contentDescription="@string/cd_descend"
            style="@style/Icon18" />
    </FrameLayout>

    <TextView
        android:id="@+id/group_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="[-] Workout :: 44:00"
        android:textSize="18sp"
        android:paddingTop="12sp"
        android:paddingBottom="12sp"
        android:textColor="@color/foreground" />

    <FrameLayout
        android:id="@+id/add_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12sp"
        android:contentDescription="@string/cd_add_task">

        <ImageView
            android:src="@drawable/icon_plus_solid"
            android:contentDescription="@string/cd_add_task"
            style="@style/Icon18" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/reset_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12sp"
        android:contentDescription="@string/cd_reset_group">

        <ImageView
            android:src="@drawable/icon_refresh"
            android:contentDescription="@string/cd_reset_group"
            style="@style/Icon18" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/start_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12sp"
        android:contentDescription="@string/cd_start_group">

        <ImageView
            android:id="@+id/start_group_icon"
            android:layout_width="18sp"
            android:layout_height="18sp"
            android:src="@drawable/icon_play"
            android:contentDescription="@string/cd_start_group"
            style="@style/Icon18" />
    </FrameLayout>

</LinearLayout>
